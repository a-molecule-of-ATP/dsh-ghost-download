{
  "name": "@local/dsh-ghost-download",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin that drives Ghost Downloader via its official ghd CLI: add, probe, list, inspect, pause, resume, remove, and wait for downloads.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "ghost-downloader",
    "ghd",
    "download"
  ],
  "license": "MIT",
  "author": "a-molecule-of-ATP",
  "repository": {
    "type": "git",
    "url": "https://github.com/a-molecule-of-ATP/dsh-ghost-download.git"
  },
  "bugs": {
    "url": "https://github.com/a-molecule-of-ATP/dsh-ghost-download/issues"
  },
  "homepage": "https://github.com/a-molecule-of-ATP/dsh-ghost-download#readme",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/cosmokit": "*"
  },
  "bundledDependencies": [
    "@deepseek-ai/schemastery",
    "@deepseek-ai/cosmokit"
  ]
}
